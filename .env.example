# 复制为 .env 并填入真实值: cp .env.example .env

# 阿里云百炼 API Key (必填,TTS 使用)
QWEN_APIKEY=

# 可选:覆盖默认值
# QWEN_BASEURL=https://llm-eizr56utguljv7y8.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# IELTS_SPEAK_TTS_BASEURL=https://llm-eizr56utguljv7y8.cn-beijing.maas.aliyuncs.com
# IELTS_SPEAK_TTS_MODEL=qwen3-tts-flash
# IELTS_SPEAK_TTS_CACHE=.cache/tts
# IELTS_SPEAK_DATA=2605-08-speak.md

# 管理员账号 (必填,首次启动自动创建;已有同名用户会被提升为管理员并重置密码)
IELTS_ADMIN_USER=admin
IELTS_ADMIN_PASSWORD=

# 可选:SQLite 数据库路径 (默认项目根目录 ielts.db)
# IELTS_DB=/opt/ielts-speak/ielts.db
